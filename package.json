{
  "name": "iherb-api",
  "version": "0.1.0",
  "description": "Typed iHerb product search and supplement label extraction for Bun and Node.js",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "iherb-api": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "chrome-remote-interface": "^0.34.0",
    "fuse.js": "^7.1.0",
    "tough-cookie": "^5.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
