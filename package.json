{
  "name": "iherb-api",
  "version": "0.1.0",
  "description": "Typed iHerb product search and supplement label extraction for Bun and Node.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntonIXO/iherb-api.git"
  },
  "bugs": {
    "url": "https://github.com/AntonIXO/iherb-api/issues"
  },
  "homepage": "https://github.com/AntonIXO/iherb-api#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "iherb-api": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cookies": "bun src/cli.ts",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "fuse.js": "^7.1.0",
    "tough-cookie": "^5.1.2"
  },
  "optionalDependencies": {
    "@primno/dpapi": "^2.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
